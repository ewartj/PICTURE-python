# Copy this file to .env and edit before running docker compose.
# .env is listed in .dockerignore and .gitignore — never commit it.

# Postgres password (also used in DATABASE_URL below)
POSTGRES_PASSWORD=secret

# Full SQLAlchemy connection string — must match POSTGRES_PASSWORD above
DATABASE_URL=postgresql://picture:secret@db:5432/picture

# Host path to your CSV/Parquet data files.
# Used only by the migrate service; not needed for normal startup.
PICTURE_DATA_DIR=./data/dmv/csv
